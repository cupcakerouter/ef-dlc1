	colorTo: 9e8ec0FF
	particleRad: 7
	particleLife: 300
	particleSize: 3
	fadeMargin: 1
	rotateScl: 1.25
	circleStroke: 0
    }
    {
      type: DrawRegion
      suffix: -top
    }
  ]
}

craftEffect: {
    type: RadialEffect
    layer: 118
    rotationSpacing: 60
    amount: 6
    lengthOffset: 6
    effect: {
      particles: 1
      length: 90
      lifetime: 180
      cone: 20
      baseRotation: 32
      useRotation: false 
      sizeFrom: 0
      sizeTo: 6
      colorFrom: e0e0e066
      colorTo: e0e0e000
      sizeInterp: pow2Out
      interp: pow2Out
      layer: 111
   			 }
