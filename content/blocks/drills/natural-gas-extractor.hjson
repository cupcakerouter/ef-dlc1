type: AttributeCrafter
name: Natural Gas Extractor
description: Productes natural gas from vents. !!!PRETEND IT IS MAKING 6/NG A SECOND AND IT USES 1/s NEUTRALIZER!!!
size: 3
attribute: natural-gas
displayEfficiencyScale: 0.11111111111
displayEfficiency: false
minEfficiency: 1.2
squareSprite: false
category: production
hasLiquids: true
hasPower: true

craftTime: 60
consumes: {
liquids: [
efdlc-neutralizer/0.01666666666666666
]
}
outputLiquid: efdlc-natural-gas/0.1


requirements: [
    efdlc-scrap/120
    efdlc-copper/75
    efdlc-cupride/25
]


ambientSound: loopHum
ambientSoundVolume: 0.3

drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawLiquidRegion
      suffix: -liquid
      drawLiquid: efdlc-natural-gas
      alpha: 1
      padding: 3
    } 
    {
      type: DrawRegion
      suffix: -rotator
      spinSprite: true
      rotateSpeed: -8
    }
    {
      type: DrawDefault
    }
  ]
}





