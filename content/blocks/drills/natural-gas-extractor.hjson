type: AttributeCrafter
name: Natural Gas Extractor
description: Extractors natural gas from shale vents using a small amount of neutralizer.
size: 3
attribute: natural-gas
displayEfficiencyScale: 0.011111111111
displayEfficiency: false
baseEfficiency: 0
boostScale: 0.111111111111
maxBoost: 1
minEfficiency: 8
squareSprite: false
category: production
hasLiquids: true
hasPower: false

craftTime: 60
consumes: {
liquids: [
efdlc-neutralizer/0.01666666666666666
]
}
outputLiquid: efdlc-natural-gas/0.1


requirements: [
    efdlc-scrap/120
    efdlc-copper/75
    efdlc-cupride/25
]


ambientSound: loopHum
ambientSoundVolume: 0.3

drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    },
    {
      type: DrawLiquidRegion
      suffix: -gas
      drawLiquid: efdlc-natural-gas
      alpha: 1
      padding: 3
    },
    {
    type: drawParticles
	color: 9e8ec0
