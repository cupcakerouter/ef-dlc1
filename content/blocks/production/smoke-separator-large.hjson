type: GenericCrafter
name: Smoke Separator
description: CO2
category: crafting
size: 4

hasLiquids: true
hasItems: true
squareSprite: false
hasPower: true


liquidCapacity: 100
itemCapacity: 25

outputLiquids: [
    efdlc-ozone/0.5
]


consumes: {
  power: 0.3
	liquids: [
    efdlc-carbon-dioxide/0.2
    efdlc-neutralizer/0.1
  ]
	items: [
	efdlc-arsenic/1
	]
}
craftTime: 60


ambientSound: loopSteam
ambientSoundVolume: 0.1


requirements: [
  efdlc-scrap/50
  efdlc-copper/25
]


drawer: {
  type: DrawMulti
  drawers: [
## CO2 window
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawLiquidRegion
		  suffix: -liquid2
      drawLiquid: efdlc-carbon-dioxide
      alpha: 1
      padding: 3
    } 
		{
			type: DrawRegion
			suffix: -rotator
			spinSprite: true
			rotateSpeed: -1.5
		}    
## O3 window
    {
      type: DrawRegion
      suffix: -bottom2
    }
    {
      type: DrawLiquidRegion
		  suffix: -liquid
      drawLiquid: efdlc-ozone
      alpha: 1
      padding: 3
    }


		{
			type: DrawDefault
		}
	{
type: DrawCrucibleFlame
flameRadiusScl: 15
circleStroke: 1
circleSpace: 1.25

flameRadiusMag: 1
flameRad: 0.25
particles: 0
	}
    {
		  type: DrawGlowRegion
		  suffix: -glow
		  glowScale: 50
			color: 2f2a2e
		}

  ]
}
