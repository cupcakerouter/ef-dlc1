type: GenericCrafter
name: Smoke Separator
description: CO2
category: crafting
size: 4

hasLiquids: true
hasItems: true
squareSprite: false
hasPower: true


liquidCapacity: 100
itemCapacity: 25

outputLiquids: [
    efdlc-neutralizer/0.5
]


consumes: {
    power: 0.3
	liquids: [
        efdlc-carbon-dioxide/0.2
        efdlc-neutralizer/0.1
    ]
items: [
efdlc-arsenic/1
]
}
craftTime: 60


ambientSound: loopSteam
ambientSoundVolume: 0.1


requirements: [
  efdlc-scrap/50
  efdlc-copper/25
]


drawer: {
  type: DrawMulti
  drawers: [
	{
	type: DrawDefault
	}
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawRegion
      suffix: -rotator
      spinSprite: true
      rotateSpeed: 5
    }
    
    {
      type: DrawRegion
      suffix: -bottom2
    }
    {
      type: DrawLiquidRegion
	  suffix: -liquid
      drawLiquid: efdlc-neutralizer
      alpha: 1
      padding: 3
    }

    {
	  type: DrawGlowRegion
	  suffix: -glow
	  glowScale: 50
	  color: 80EAFFFF
	}
  ]
}
