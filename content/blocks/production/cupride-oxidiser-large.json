type: HeatProducer
name: Large Cupride Chamber
description: Oxidizes copper using ozone. Uses slag for powering itself and neutralizer to get rid of pollution. Outputs a decent amount of heat.
size: 5

hasLiquids: true
hasPower: true
hasItems: true
craftTime: 120
squareSprite: false
itemCapacity: 30
liquidCapacity: 200

ambientSound: loopHum
ambientSoundVolume: 0.06
category: crafting


requirements: [
	efdlc-scrap/250
	efdlc-copper/120
	efdlc-cupride/100
	efdlc-arsenic-fiber/25
]


consumes: {
	items: [
   	efdlc-copper/4
	]
	liquids: [
		efdlc-ozone/0.4
		efdlc-neutralizer/0.3
        efdlc-slag/0.1
	]
}


outputItems: [
	efdlc-cupride/10
]
outputLiquids: [
    efdlc-hydrogen/0.5
]
heatOutput: 30
sideHeat: [1]

drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
	  type: DrawLiquidRegion
      suffix: -liquid
      drawLiquid: efdlc-ozone
      alpha: 1
      padding: 3
	}
    {
	  type: DrawDefault
	}
   {
      type: DrawGlowRegion
      alpha: 1
      glowIntensity: 0.6
      color: FF40BFFF
      suffix: -glow
      glowScale: 15
    }
    {
	  type: DrawCrucibleFlame
	  particleRad: 10
	  flameRad: 0
	  partcileSize: 4
	  rotateScl: 2
	  particles: 50
	  particleLife: 120

	  circleStroke: 10
	}
    {
	  type: DrawHeatOutput
	}
    {
	  type: DrawRegion
	  suffix: -top
	} 
  ]
} 

