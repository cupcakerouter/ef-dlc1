type: HeatProducer
name: Large Cupride Chamber
description: Oxidizes copper using ozone. Uses slag for powering itself and neutralizer to get rid of pollution. Outputs a decent amount of heat.
size: 5

hasLiquids: true
hasPower: true
hasItems: true
craftTime: 120
squareSprite: false


ambientSound: loopHum
ambientSoundVolume: 0.06
category: crafting


requirements: [
	efdlc-scrap/250
	efdlc-copper/120
	efdlc-cupride/150
	efdlc-arsenic-fiber/25
]


consumes: {
	items: [
   	efdlc-copper/4
	]
	liquids: [
		efdlc-ozone/0.4
		efdlc-neutralizer/0.3
        efdlc-slag/0.1
	]
}


outputItems: [
	efdlc-cupride/10
]
outputLiquids: [
    efdlc-hydrogen/0.5
]
heatOutput: 30
sideHeat: [1]

drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
	  type: DrawLiquidRegion
      suffix: -liquid
      drawLiquid: efdlc-ozone
      alpha: 1
      padding: 3
	}
    {
	  type: DrawDefault
	}

    {
      type: DrawPlasma
	  plasmas: 2
	  plasma1: 9e318b
	  plasma2: da75c9
flameRadius: 15	
    }

    {
	  type: DrawHeatOutput
	}
    {
	  type: DrawRegion
	  suffix: -top
	} 
  ]
} 

